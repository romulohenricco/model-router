# Copie para .env (ou exporte no shell). Nunca commite chaves reais.
# Só são necessárias para provedores opcionais pagos por API.
MINIMAX_API_KEY=
ZAI_API_KEY=
# Google Gemini (API paga ou gratuita): https://aistudio.google.com/apikey
# No nível gratuito o Google pode usar os prompts para melhorar seus produtos;
# por isso dados confidential/restricted nunca são roteados para o Gemini.
GEMINI_API_KEY=

# Onde gravar logs de execução e o ledger de custo (padrão: ./logs)
# MODEL_ROUTER_LOG_DIR=./logs
